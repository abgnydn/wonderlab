# wonderlab environment — only used by `npm run dev` (the optional
# Node server at server/server.js). The deployed Cloudflare site is
# 100% static and reads zero env variables.

# Which backend the dev Node server should call when it gets /api/ask.
# One of: claude (default — uses your Claude Code CLI auth, no key) |
# gemini | cerebras | lmstudio
WONDER_BACKEND=claude

# Pick a specific model id (otherwise a sensible default per backend).
# claude:   sonnet | haiku-4-5 | opus-4-7
# gemini:   gemini-2.5-flash | gemini-2.5-flash-lite | gemini-2.5-pro
# cerebras: llama-3.3-70b
# lmstudio: any model id loaded in your LM Studio
# WONDER_MODEL=sonnet

# Backend keys — only set the one for the backend you've selected.
# GEMINI_API_KEY=AI...
# CEREBRAS_API_KEY=...
# LMSTUDIO_URL=http://localhost:1234/v1/chat/completions

# Dev server port (default 5173)
# PORT=5173
